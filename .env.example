# Copy to .env and replace every placeholder with a unique local value.
# Do not commit .env or reuse passwords from other accounts.
NEO4J_PASSWORD=replace-with-a-unique-password-at-least-8-characters
INFLUXDB_USERNAME=cryptosentinel
INFLUXDB_PASSWORD=replace-with-a-unique-influx-password
INFLUXDB_TOKEN=replace-with-a-long-random-influx-token
INFLUXDB_ORG=cryptosentinel
INFLUXDB_BUCKET=cryptosentinel
INFLUXDB_RETENTION=30d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-grafana-password

# Binance Spot stream host; default works with the public market-data endpoint.
# Set to wss://stream.binance.com:9443 to use the original endpoint instead.
BINANCE_WS_BASE=wss://data-stream.binance.vision

# Optional local tuning; safe defaults are in docker-compose.yml.
KAFKA_STARTING_OFFSETS=earliest
KAFKA_PRODUCER_BATCH_SIZE=32768
KAFKA_PRODUCER_LINGER_MS=20
KAFKA_CONSUMER_MAX_RECORDS=200
SPARK_MAX_OFFSETS_PER_TRIGGER=500
SPARK_WATERMARK_DELAY=30 seconds
